// Package service generated for PRZM benchmarking.
package service

import (
	"context"
	"fmt"
	"time"
)

// HandleTask1 executes the background task for step 1.
func (s *WorkerService) HandleTask1(ctx context.Context, req *TaskRequest1) (*TaskResponse, error) {
	if req == nil {
		return nil, fmt.Errorf("task 1: request payload cannot be nil")
	}
	select {
	case <-ctx.Done():
		return nil, ctx.Err()
	default:
	}
	start := time.Now()
	res, err := s.client.ProcessItem(ctx, req.ItemID, 100)
	if err != nil {
		return nil, fmt.Errorf("task 1 failed to process item %d: %w", req.ItemID, err)
	}
	s.logger.Info("Task 1 completed successfully", "duration_ms", time.Since(start).Milliseconds())
	return &TaskResponse{Status: "SUCCESS", Result: res}, nil
}

